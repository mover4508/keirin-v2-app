{
  "name": "競輪予想 Ver.2",
  "short_name": "競輪予想",
  "lang": "ja",
  "description": "出走表と3連複オッズを取り込み、予想・結果照合・学習を記録します。",
  "id": "./",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#eef4f0",
  "theme_color": "#096450",
  "share_target": {
    "action": "./receive-share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "text": "text",
      "url": "url",
      "files": [{"name":"race_file","accept":[".json",".txt","application/json","text/plain"]}]
    }
  },
  "icons": [{"src":"icon-192.png","sizes":"192x192","type":"image/png"},{"src":"icon-512.png","sizes":"512x512","type":"image/png"}]
}
